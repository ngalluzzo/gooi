{
  "name": "@gooi/react",
  "version": "0.1.0",
  "description": "Lower a designer's selector mapping to a React renderer, and render pages with it",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "dev": "./src/index.ts",
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "bun test ./src"
  },
  "dependencies": {
    "@gooi/estree": "workspace:*",
    "@gooi/exchange": "workspace:*",
    "@gooi/hast": "workspace:*",
    "@gooi/kernel": "workspace:*",
    "hast-util-from-html": "^2.0.3",
    "hast-util-select": "^6.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}

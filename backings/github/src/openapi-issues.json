{
  "$comment": "Extracted from https://raw.githubusercontent.com/github/rest-api-description/main/descriptions/api.github.com/api.github.com.json by backings/github/scripts/openapi.ts. Do not edit.",
  "apiVersion": "1.1.4",
  "operationId": "issues/list-for-repo",
  "path": "/repos/{owner}/{repo}/issues",
  "parameters": [
    {

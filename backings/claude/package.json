{
  "name": "@gooi/claude",
  "version": "0.1.0",
  "description": "A Claude backing for gooi's agent loop, through the Anthropic SDK",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "dev": "./src/index.ts",
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "bun test ./src"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@gooi/agent": "workspace:*"
  },
  "devDependencies": {
    "@gooi/exchange": "workspace:*",
    "@gooi/kernel": "workspace:*"
  }
}

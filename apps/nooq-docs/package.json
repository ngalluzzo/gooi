{
  "name": "@gooi/nooq-docs",
  "version": "0.1.0",
  "private": true,
  "description": "nooq documents on a gooi log: read, suggest, accept and reject, through nooq's own model. nooq's packages come from the nooq checkout beside this repo (tsconfig paths).",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "dev": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "bun test ./src"
  },
  "dependencies": {
    "@gooi/exchange": "workspace:*",
    "@gooi/hast": "workspace:*",
    "@gooi/kernel": "workspace:*",
    "@gooi/log": "workspace:*",
    "mdast-util-from-markdown": "^2",
    "mdast-util-gfm": "^3",
    "mdast-util-to-hast": "^13",
    "micromark-extension-gfm": "^3"
  },
  "devDependencies": {
    "@gooi/jsonl": "workspace:*",
    "@gooi/sqlite": "workspace:*",
    "@types/hast": "^3",
    "@types/mdast": "^4"
  }
}
